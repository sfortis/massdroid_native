<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older; the same set as backup_rules.xml, which explains it. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="database" path="massdroid.db-wal" />
    <exclude domain="database" path="massdroid.db-shm" />
</full-backup-content>
