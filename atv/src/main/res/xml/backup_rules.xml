<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android backup and device transfer copy: the play history database, the shared
    preferences and the settings DataStore. The "device" DataStore next to it holds the MA
    credentials and this device's own identity and calibration, and is left out on purpose
    (SettingsRepositoryImpl). DataStore files live under files/, hence domain="file".
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="massdroid.db-wal" />
        <exclude domain="database" path="massdroid.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="massdroid.db-wal" />
        <exclude domain="database" path="massdroid.db-shm" />
    </device-transfer>
</data-extraction-rules>
